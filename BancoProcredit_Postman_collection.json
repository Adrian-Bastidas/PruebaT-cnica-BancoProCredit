              "port": "7139",
              "path": ["api", "empleados", "departamento", "1"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Obtiene empleados paginados de un departamento específico. Cambiar el número (1) por el ID del departamento. Parámetros: pageNumber, pageSize"
          },
          "response": []
        },
        {
          "name": "Create Empleado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroDocumento\": \"9876543210\",\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"edad\": 28,\n  \"remuneracionMensual\": 2500.00,\n  \"departamentoID\": 1,\n  \"cargoID\": 1\n}"
            },
            "url": {
              "raw": "https://localhost:7139/api/empleados",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7139",
              "path": ["api", "empleados"]
            },
            "description": "Crea un nuevo empleado. El numeroDocumento debe ser único. Edad: 18-65, Remuneración > 0"
          },
          "response": []
        },
        {
          "name": "Update Empleado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroDocumento\": \"9876543210\",\n  \"nombre\": \"Juan\",\n  \"apellido\": \"García\",\n  \"edad\": 29,\n  \"remuneracionMensual\": 2700.00,\n  \"departamentoID\": 2,\n  \"cargoID\": 2\n}"
            },
            "url": {
              "raw": "https://localhost:7139/api/empleados/11",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7139",
              "path": ["api", "empleados", "11"]
            },
            "description": "Actualiza un empleado existente. Cambiar 11 por el ID del empleado. Retorna 204 No Content si es exitoso"
          },
          "response": []
        },
        {
          "name": "Delete Empleado",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://localhost:7139/api/empleados/11",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7139",
              "path": ["api", "empleados", "11"]
            },
            "description": "Elimina un empleado (borrado lógico). Cambiar 11 por el ID del empleado. Retorna 204 No Content si es exitoso"
          },
          "response": []
        }
      ]
