{
  "info": {
    "_postman_id": "bancoprocredit-api-v2",
    "name": "Banco ProCredit API v2",
    "description": "Colección completa de endpoints con paginación - Puerto 7139 HTTPS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.environment.set('expiresAt', jsonData.expiresAt);",
                  "    console.log('✅ Token guardado:', jsonData.token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"admin@admin.com\",\n  \"password\": \"Flerovio\"\n}"
            },
            "url": {
              "raw": "https://localhost:7139/api/auth/login",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7139",
              "path": ["api", "auth", "login"]
            },
            "description": "Login con usuario de prueba (admin@admin.com/Flerovio). Retorna JWT token válido por 1 hora"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Empleados",
      "item": [
        {
          "name": "Get All Empleados (Paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://localhost:7139/api/empleados?pageNumber=1&pageSize=10",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7139",
              "path": ["api", "empleados"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Obtiene lista paginada de todos los empleados activos. Parámetros: pageNumber (default 1), pageSize (default 10)"
          },
          "response": []
        },
        {
          "name": "Get Empleado by ID",
          "request": {
            "method": "GET",
            "header": [
              {
